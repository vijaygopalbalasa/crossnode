# Security policy rules for the Crossnode types in the pair layout, as recorded by secpolgenerate
# (image/record-policy.sh) at be2f81a and then enforced with CN_SECPOL=secure. Only these types are shown; the full
# policies are recorded on your own build. hellodev is the test device. Every ability not listed is denied.

# --- front ---
# === Rules for type crossnode_agent_t ============
allow crossnode_agent_t self:ability {
    nonroot
    prot_exec
    map_fixed
    channel_connect:random_t,io_sock_t,hellodev_t
    network/jailroot
};

# === Rules for type hellodev_t ============
allow_attach hellodev_t {
    /dev/hello
};
allow hellodev_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
};

# --- central ---
# === Rules for type crossnode_net_t ============
allow_attach crossnode_net_t {
    /net/front
};
allow crossnode_net_t self:ability {
    nonroot
    pathspace
    prot_exec
    map_fixed
    public_channel
    channel_connect:random_t,pipe_t,io_sock_t
    network/jailroot
};
